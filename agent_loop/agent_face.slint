// Cartoon agent face for the agent_loop app (320x480 ST7796 LCD).
//
// render_by_line constraints honored here:
//   - No Path items (the software renderer skips them silently).
//   - No rotation. Every round shape is a Rectangle with border-radius.
//   - Text is fine: `slint-cli --embed-resources software-renderer` embeds a
//     DejaVu Sans bitmap font into the generated Rust code.
//
// The Rust side pushes `state` (0-8) plus preformatted strings, and drives
// `spin-x`/`spin-y`/`blink` per frame. `pulse`, `z-lift-a/b` and
// `intro-progress` are self-running animations (single init trigger,
// infinite iteration).

export component MainWindow inherits Window {
    width: 320px;
    height: 480px;
    background: #0b0f12;
    default-font-size: 10px;

    // Agent-side inputs.
    in property <int> state;         // 0-8, see ui::AgentState
    in property <string> status;     // e.g. "thinking", "tool: led_matrix_draw"
    in property <string> round-text; // e.g. "R2/4"
    in property <string> turn-text;  // e.g. "t1200ms"
    // Per-frame animation drivers from the UI thread.
    in property <float> spin-x;
    in property <float> spin-y;
    in property <float> blink;

    // Self-running animation clocks.
    property <float> intro-progress: 0;
    property <float> pulse: 0.2;
    property <float> z-lift-a: 0;
    property <float> z-lift-b: 0;
    init => {
        intro-progress = 1;
        pulse = 1;
        z-lift-a = 1;
        z-lift-b = 1;
    }
    animate intro-progress {
        duration: 450ms;
        easing: ease-out;
    }
    animate pulse {
        duration: 900ms;
        easing: ease-in-out;
        iteration-count: -1;
        direction: alternate;
    }
    animate z-lift-a {
        duration: 2200ms;
        easing: linear;
        iteration-count: -1;
    }
    animate z-lift-b {
        duration: 3100ms;
        easing: linear;
        iteration-count: -1;
    }

    // State predicates.
    property <bool> is-connecting: state == 1;
    property <bool> is-thinking: state == 2;
    property <bool> is-streaming: state == 3;
    property <bool> is-reasoning: state == 4;
    property <bool> is-tool: state == 5;
    property <bool> is-yielding: state == 6;
    property <bool> is-done: state == 7;
    property <bool> is-error: state == 8;

    // Eye geometry. Base eye: 34x44, vertical center fixed at y=192.
    property <float> left-eye-factor:
        is-thinking ? 0.45 :
        is-streaming ? 1.1 :
        is-reasoning ? 0.3 :
        is-yielding ? 0.14 :
        is-done ? 0.55 :
        is-tool ? 0.95 :
        is-connecting ? 0.9 : 1.0;
    property <float> right-eye-factor: is-tool ? 0.15 : left-eye-factor;
    property <length> eye-look-up: is-connecting ? 10px : 0px;

    // Mouth geometry.
    property <length> mouth-w:
        is-streaming ? 26px :
        is-done ? 96px :
        is-reasoning ? 72px :
        is-tool ? 60px :
        is-thinking ? 48px :
        is-error ? 60px :
        is-yielding ? 32px :
        is-connecting ? 40px : 56px;
    property <length> mouth-h:
        is-streaming ? 26px :
        is-done ? 30px :
        is-reasoning ? 20px :
        is-tool ? 16px :
        is-thinking ? 8px :
        is-error ? 8px :
        is-yielding ? 6px :
        is-connecting ? 6px : 8px;
    property <length> mouth-radius:
        is-streaming ? 13px :
        is-done ? 15px :
        is-reasoning ? 10px :
        is-tool ? 8px : 4px;

    // Accessory opacity helpers.
    property <float> radio-opacity: is-connecting ? 0.55 + 0.45 * pulse : 0;
    property <float> gear-opacity: is-tool ? 0.4 + 0.6 * pulse : 0;
    property <float> bulb-opacity: is-reasoning ? 0.5 + 0.5 * pulse : 0;

    // ===== Face (declared first: the spinner orbits behind the head) =====

    // Thinking spinner dot: position pushed per frame from Rust (sin/cos).
    Rectangle {
        x: 160px + 110px * spin-x - 8px;
        y: 205px + 95px * spin-y - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #f4d35e;
        opacity: is-thinking ? 0.9 : 0;
    }

    // Head.
    Rectangle {
        x: 60px;
        y: 120px;
        width: 200px;
        height: 170px;
        border-radius: 85px;
        background: #ffd166;
        opacity: 0.3 + 0.7 * intro-progress;
    }

    // Left eye.
    Rectangle {
        x: 104px;
        y: 192px - self.height / 2 - eye-look-up;
        width: 34px;
        height: 44px * left-eye-factor * blink;
        border-radius: 17px;
        background: #12333b;
        opacity: is-error ? 0 : 1;
    }

    // Right eye (winks during ToolRunning).
    Rectangle {
        x: 182px;
        y: 192px - self.height / 2 - eye-look-up;
        width: 34px;
        height: 44px * right-eye-factor * blink;
        border-radius: 17px;
        background: #12333b;
        opacity: is-error ? 0 : 1;
    }

    // X eyes for the Error state (Text "X" — no rotation needed).
    Text {
        x: 100px;
        y: 170px;
        width: 42px;
        height: 42px;
        text: "X";
        font-size: 28px;
        color: #ef476f;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: is-error ? 1 : 0;
    }
    Text {
        x: 178px;
        y: 170px;
        width: 42px;
        height: 42px;
        text: "X";
        font-size: 28px;
        color: #ef476f;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: is-error ? 1 : 0;
    }

    // Mouth.
    Rectangle {
        x: 160px - mouth-w / 2;
        y: is-error ? 246px : 252px;
        width: mouth-w;
        height: mouth-h;
        border-radius: mouth-radius;
        background: is-error ? #ef476f : #12333b;
    }

    // Cheek blushes for the Done state.
    Rectangle {
        x: 88px;
        y: 236px;
        width: 18px;
        height: 10px;
        border-radius: 5px;
        background: #ef8354;
        opacity: is-done ? 0.8 : 0;
    }
    Rectangle {
        x: 214px;
        y: 236px;
        width: 18px;
        height: 10px;
        border-radius: 5px;
        background: #ef8354;
        opacity: is-done ? 0.8 : 0;
    }

    // ===== Accessories above the head =====

    // Connecting: radio-wave bars, breathing opacity.
    Rectangle {
        x: 151px;
        y: 88px;
        width: 18px;
        height: 8px;
        border-radius: 4px;
        background: #06d6a0;
        opacity: radio-opacity;
    }
    Rectangle {
        x: 144px;
        y: 74px;
        width: 32px;
        height: 8px;
        border-radius: 4px;
        background: #06d6a0;
        opacity: 0.7 * radio-opacity;
    }
    Rectangle {
        x: 137px;
        y: 60px;
        width: 46px;
        height: 8px;
        border-radius: 4px;
        background: #06d6a0;
        opacity: 0.45 * radio-opacity;
    }

    // ToolRunning: gear (ring + hub + 4 teeth), pulsing.
    Rectangle {
        x: 142px;
        y: 84px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: transparent;
        border-color: #4cc9f0;
        border-width: 5px;
        opacity: gear-opacity;
    }
    Rectangle {
        x: 155px;
        y: 97px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: #4cc9f0;
        opacity: gear-opacity;
    }
    Rectangle {
        x: 156px;
        y: 76px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: #4cc9f0;
        opacity: gear-opacity;
    }
    Rectangle {
        x: 156px;
        y: 120px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: #4cc9f0;
        opacity: gear-opacity;
    }
    Rectangle {
        x: 134px;
        y: 98px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: #4cc9f0;
        opacity: gear-opacity;
    }
    Rectangle {
        x: 180px;
        y: 98px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: #4cc9f0;
        opacity: gear-opacity;
    }

    // Reasoning: idea bulb, popping.
    Rectangle {
        x: 160px - self.width / 2;
        y: 78px;
        width: 20px + 12px * pulse;
        height: 20px + 12px * pulse;
        border-radius: self.width / 2;
        background: #f4d35e;
        opacity: bulb-opacity;
    }
    Rectangle {
        // bulb stem
        x: 156px;
        y: 100px;
        width: 8px;
        height: 10px;
        border-radius: 2px;
        background: #f4d35e;
        opacity: bulb-opacity;
    }

    // YieldingWifi: floating "z" letters.
    Text {
        x: 196px;
        y: 110px - 70px * z-lift-a;
        text: "z";
        font-size: 18px;
        color: #9bf6ff;
        opacity: is-yielding ? 1 - z-lift-a : 0;
    }
    Text {
        x: 218px;
        y: 132px - 55px * z-lift-b;
        text: "z";
        font-size: 13px;
        color: #9bf6ff;
        opacity: is-yielding ? 0.8 * (1 - z-lift-b) : 0;
    }

    // ===== Bottom status bar =====
    Rectangle {
        y: 428px;
        width: 320px;
        height: 1px;
        background: #26313a;
    }
    Text {
        x: 8px;
        y: 440px;
        width: 56px;
        height: 16px;
        text: round-text;
        color: #06d6a0;
    }
    Text {
        x: 68px;
        y: 440px;
        width: 176px;
        height: 16px;
        text: status;
        color: #e8f1f2;
        overflow: elide;
    }
    Text {
        x: 248px;
        y: 440px;
        width: 64px;
        height: 16px;
        text: turn-text;
        color: #8aa0ab;
        horizontal-alignment: right;
    }
}
