{
    "capabilities": [
        {
            "name": "sensor_read",
            "description": "Read the current temperature, air pressure, and relative humidity from the onboard BME280 sensor.",
            "handler": "sensor_read",
            "parameters": {
                "type": "object",
                "properties": {
                    "sensor": {
                        "type": "string",
                        "enum": [
                            "temperature_humidity"
                        ],
                        "description": "BME280 temperature, air pressure, and relative humidity measurement."
                    }
                },
                "required": [
                    "sensor"
                ],
                "additionalProperties": false
            }
        },
        {
            "name": "led_program",
            "description": "Run a programmable LED timeline. Use kind=steps for arbitrary sequences (including colors and durations), or kind=morse for Morse-code text blinking.",
            "handler": "led_program",
            "parameters": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "steps",
                            "morse",
                            "hold"
                        ],
                        "description": "Program mode. Use steps for arbitrary timelines, morse for text blinking, hold to set a steady state that persists until the next led_program call (no duration limit)."
                    },
                    "repeat": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Repeat the program this many times."
                    },
                    "steps": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Required when kind=steps.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "state": {
                                    "type": "string",
                                    "enum": [
                                        "on",
                                        "off"
                                    ],
                                    "description": "State to apply for this step"
                                },
                                "color": {
                                    "type": "string",
                                    "enum": [
                                        "red",
                                        "blue",
                                        "purple",
                                        "magenta",
                                        "both"
                                    ],
                                    "description": "LED channel for this step. When state=on: specifies which channel(s) to light. When state=off: specifies which channel(s) to turn off; omit to turn off all channels. Supports red, blue, or purple/magenta/both for simultaneous channels."
                                },
                                "hold_ms": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "How long to keep this step before moving to next"
                                }
                            },
                            "required": [
                                "state"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "text": {
                        "type": "string",
                        "description": "Required when kind=morse. Text to represent in Morse code."
                    },
                    "unit_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Dot unit duration in milliseconds. Default 200"
                    },
                    "state": {
                        "type": "string",
                        "enum": [
                            "on",
                            "off"
                        ],
                        "description": "Required when kind=hold. LED state to set and maintain."
                    },
                    "color": {
                        "type": "string",
                        "enum": [
                            "red",
                            "blue",
                            "purple",
                            "magenta",
                            "both"
                        ],
                        "description": "Optional when kind=hold. LED color: red, blue, or purple/magenta/both for simultaneous channels. Defaults to red."
                    }
                },
                "required": [
                    "kind"
                ],
                "additionalProperties": false
            }
        },
        {
            "name": "led_matrix_draw",
            "description": "Draw an 8x8 monochrome image or play an animation on the MAX7219 LED matrix. Each frame has exactly eight top-to-bottom rows. In each eight-character row, 1/#/X/* means on and 0/./space means off; the leftmost character is the leftmost pixel.",
            "handler": "led_matrix_draw",
            "parameters": {
                "type": "object",
                "properties": {
                    "kind": {
                        "type": "string",
                        "enum": [
                            "image",
                            "animation"
                        ],
                        "description": "Use image for one static frame or animation for a sequence of frames."
                    },
                    "rows": {
                        "type": "array",
                        "minItems": 8,
                        "maxItems": 8,
                        "description": "Required when kind=image. Eight rows ordered from top to bottom.",
                        "items": {
                            "type": "string",
                            "minLength": 8,
                            "maxLength": 8,
                            "pattern": "^[01.#Xx* ]{8}$"
                        }
                    },
                    "frames": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "description": "Required when kind=animation. Frames are displayed in array order.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "rows": {
                                    "type": "array",
                                    "minItems": 8,
                                    "maxItems": 8,
                                    "description": "Eight rows ordered from top to bottom.",
                                    "items": {
                                        "type": "string",
                                        "minLength": 8,
                                        "maxLength": 8,
                                        "pattern": "^[01.#Xx* ]{8}$"
                                    }
                                },
                                "hold_ms": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 10000,
                                    "description": "Optional duration for this frame. Overrides frame_ms."
                                }
                            },
                            "required": [
                                "rows"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "frame_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000,
                        "description": "Default duration of each animation frame in milliseconds. Default 200."
                    },
                    "repeat": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16,
                        "description": "Number of animation repetitions. Default 1."
                    }
                },
                "required": [
                    "kind"
                ],
                "additionalProperties": false
            }
        }
    ]
}
